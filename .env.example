# Local development only. Point this at a private kubeconfig created by kind.
KUBECONFIG=/absolute/path/to/kubeconfig
CLUSTER_NAME=k8s-ui-dev
HOST=127.0.0.1
PORT=3001

# Console users (JSON list of { username, role, passwordHash }). Create it with:
#   npm run users --workspace @k8s-ui/api -- add admin admin --file .local/users.json
AUTH_USERS_FILE=/absolute/path/to/k8s-ui/.local/users.json
# 32+ random characters. Without it, a temporary secret is used and sessions end on API restart.
SESSION_SECRET=
SESSION_TTL_HOURS=8
# auto | always | never — whether the session cookie carries the Secure flag.
COOKIE_SECURE=auto
# Express "trust proxy" setting when running behind a reverse proxy, e.g. 1.
TRUST_PROXY=
# Comma-separated extra origins allowed to sign in and open log streams.
TRUSTED_ORIGINS=
